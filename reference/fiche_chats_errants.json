 "glossaire": [
  {
   "terme": "Chat errant",
   "definition": "Chat qui se trouve hors du domicile de son gardien, ou qui n'en a pas, et que personne ne surveille. C'est la définition de la Convention européenne pour la protection des animaux de compagnie, retenue par le rapport du Gouvernement."
  },
  {
   "terme": "Divagation",
   "definition": "Définition précise du code rural : un chat non identifié trouvé à plus de 200 mètres des habitations, ou un chat trouvé à plus d'un kilomètre du domicile de son maître sans surveillance, ou un chat sans propriétaire connu saisi sur la voie publique ou chez autrui (article L211-23)."
  },
  {
   "terme": "Chat libre",
   "definition": "Chat errant capturé, stérilisé, identifié au nom de la commune ou d'une association, puis relâché là où il vit. Son nourrissage y est autorisé (article L211-27 du code rural)."
  },
  {
   "terme": "Identification",
   "definition": "Puce électronique ou tatouage enregistré dans le fichier national, qui relie l'animal à son détenteur."
  }
 ],
